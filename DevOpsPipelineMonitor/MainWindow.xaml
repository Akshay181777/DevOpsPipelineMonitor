<Window x:Class="DevOpsPipelineMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevOps Pipeline Monitor"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#111827">
            <StackPanel Margin="20">
                <TextBlock Text="DevOps"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,5"/>

                <TextBlock Text="Pipeline Monitor"
                           FontSize="16"
                           Foreground="#9CA3AF"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Overview Dashboard"
                           Foreground="#D1D5DB"
                           FontSize="16"
                           Margin="0,10"/>

                <TextBlock Text="Jenkins Pipelines"
                           Foreground="#D1D5DB"
                           FontSize="16"
                           Margin="0,10"/>

                <TextBlock Text="GitHub Actions Runs"
                           Foreground="#D1D5DB"
                           FontSize="16"
                           Margin="0,10"/>

                <TextBlock Text="Click pipeline row to view logs"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,20"/>
                </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CI/CD Pipeline Status Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0,0,0,20"/>

            <UniformGrid Grid.Row="1"
                         Columns="3"
                         Margin="0,0,0,20">

                <Border Background="White" CornerRadius="12" Padding="18" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Total Pipelines" FontSize="15"/>
                        <TextBlock x:Name="TotalText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="18" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Successful" FontSize="15"/>
                        <TextBlock x:Name="SuccessText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="18" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Failed / Running" FontSize="15"/>
                        <TextBlock x:Name="FailedText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="15">

                <DataGrid x:Name="PipelineDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          RowHeight="42"
                          SelectionChanged="PipelineDataGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pipeline" Binding="{Binding PipelineName}" Width="250"/>
                        <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="Last Run" Binding="{Binding LastRun}" Width="190"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="140"/>
                        <DataGridTextColumn Header="Logs" Binding="{Binding Logs}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>